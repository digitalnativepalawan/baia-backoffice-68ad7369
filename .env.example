# BAIA Backoffice environment — COPY THIS to `.env` and fill in real values.
# NEVER commit the real `.env`. These are placeholders only.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Supabase secrets / edge functions):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_real_service_role_key_never_commit

# OpenRouter (cloud provider)
OPENROUTER_API_KEY=sk-or-...

# Local Ollama bridge (optional; runs on this machine)
OLLAMA_BRIDGE_URL=http://localhost:3001
OLLAMA_BASE_URL=http://localhost:11434
